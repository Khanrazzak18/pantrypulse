# PantryPulse settings. Copy to .env (`cp .env.example .env`) and fill in the blanks.
# .env is gitignored: never commit it. Every variable the app reads is listed here.

# --- Ports (set here and nowhere else) ---------------------------------------------------------
# Browser address of the web app.
WEB_PORT=3000
# FastAPI server. The web app proxies /api/* to it, so the browser only ever talks to WEB_PORT.
API_PORT=8000
# Postgres on your machine (5433 avoids clashing with a local Postgres on 5432).
POSTGRES_PORT=5433

# --- Postgres (docker compose creates both databases on first start) ---------------------------
POSTGRES_USER=pantrypulse
# REQUIRED. Pick any password; it only protects the local container.
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
# The app database (`make migrate`, `make seed`, `make dev`).
POSTGRES_DB=pantrypulse
# A separate database that `make test` empties and refills. Never the app database.
POSTGRES_TEST_DB=pantrypulse_test

# --- Sessions ----------------------------------------------------------------------------------
# REQUIRED, at least 32 characters. Signs login cookies. Generate: openssl rand -hex 32
JWT_SECRET=
# Hours a login lasts (default 8).
# SESSION_HOURS=8
# Set true when the site is served over https so the cookie is marked Secure (default false).
# COOKIE_SECURE=false

# --- Demo logins created by `make seed` (local development only; not real credentials) --------
# `make seed` stops with a message if any of these is missing.
DEMO_COORDINATOR_PASSWORD=demo-coordinator-pw
DEMO_ADMIN_PASSWORD=demo-admin-pw
DEMO_PANTRY_MANAGER_PASSWORD=demo-manager-pw

# --- AWS / Amazon Bedrock (donation intake, allocation reasons, monthly summary) ---------------
# Credentials come from this AWS CLI profile (`aws configure --profile pantrypulse`).
# Never put access keys in this file.
AWS_PROFILE=pantrypulse
AWS_REGION=us-east-1
# A model or inference profile ID. IDs starting with us. are cross-region inference profiles,
# needed when on-demand throughput is not supported for the model.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Files and logs ----------------------------------------------------------------------------
# Where uploaded manifests are kept, relative to the repository root (S3 in production).
STORAGE_DIR=backend/var/uploads
# DEBUG, INFO, WARNING or ERROR. Logs are JSON, one line per event.
LOG_LEVEL=INFO
