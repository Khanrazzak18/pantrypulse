# Single source of truth for ports and settings. Copy to .env and fill in.
# Never commit .env.

# Ports (defined here and nowhere else)
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5433

# Postgres (docker compose creates both databases on first start)
POSTGRES_USER=pantrypulse
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_DB=pantrypulse
POSTGRES_TEST_DB=pantrypulse_test

# Auth (Stage 3). Generate with: openssl rand -hex 32
JWT_SECRET=
# Optional: login lifetime in hours (default 8), and set true when served over https.
# SESSION_HOURS=8
# COOKIE_SECURE=false

# Demo logins created by `make seed` (local development only; not real credentials).
# make seed fails if any of these is missing from .env.
DEMO_COORDINATOR_PASSWORD=demo-coordinator-pw
DEMO_ADMIN_PASSWORD=demo-admin-pw
DEMO_PANTRY_MANAGER_PASSWORD=demo-manager-pw

# AWS / Bedrock (Stage 4). Credentials come from the AWS CLI profile, never keys here.
AWS_PROFILE=pantrypulse
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Logging
LOG_LEVEL=INFO
