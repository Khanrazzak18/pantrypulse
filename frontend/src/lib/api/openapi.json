    "/api/donations/{donation_id}/confirm": {
      "post": {
        "tags": [
          "donations"
        ],
        "summary": "Confirm Donation",
        "description": "Create the donation's items and one inventory lot per item from the coordinator's rows.",
        "operationId": "confirm_donation_api_donations__donation_id__confirm_post",
        "parameters": [
          {
            "name": "donation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Donation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DonationDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/donations/{donation_id}/reject": {
      "post": {
        "tags": [
          "donations"
        ],
        "summary": "Reject Donation",
        "description": "Add nothing to inventory. The upload stays on record as rejected.",
        "operationId": "reject_donation_api_donations__donation_id__reject_post",
        "parameters": [
          {
            "name": "donation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Donation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DonationDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
