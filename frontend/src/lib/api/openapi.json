          }
        }
      }
    },
    "/api/forecasts": {
      "get": {
        "tags": [
          "forecasts"
        ],
        "summary": "List Forecasts",
        "operationId": "list_forecasts_api_forecasts_get",
        "parameters": [
          {
            "name": "pantry_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Pantry Id"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "produce",
                    "dairy",
                    "protein",
                    "bakery",
                    "frozen",
                    "canned",
                    "dry_goods",
                    "beverages"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "name": "week_start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Week Start"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "forward",
                "backtest"
              ],
              "type": "string",
              "default": "forward",
              "title": "Kind"
            }
          },
          {
            "name": "run_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Run Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "default": 1000,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ForecastRowOut"
                  },
                  "title": "Response List Forecasts Api Forecasts Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/forecasts/series": {
      "get": {
        "tags": [
          "forecasts"
        ],
        "summary": "Forecast Series",
        "description": "Everything the chart needs for one pantry and category: recent actuals, the backtest\nforecasts for the weeks that have happened, and next week's forecast.",
        "operationId": "forecast_series_api_forecasts_series_get",
        "parameters": [
          {
            "name": "pantry_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Pantry Id"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "produce",
                "dairy",
                "protein",
                "bakery",
                "frozen",
                "canned",
                "dry_goods",
                "beverages"
              ],
              "type": "string",
              "title": "Category"
            }
          },
          {
            "name": "history_weeks",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 104,
              "minimum": 4,
              "default": 26,
              "title": "History Weeks"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastSeries"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
