  "components": {
    "schemas": {
      "Body_upload_donation_api_donations_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_donation_api_donations_post"
      },
      "ConfirmItem": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "category": {
            "type": "string",
            "enum": [
              "produce",
              "dairy",
              "protein",
              "bakery",
              "frozen",
              "canned",
              "dry_goods",
              "beverages"
            ],
            "title": "Category"
          },
          "quantity": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "unit": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Unit"
          },
          "estimated_weight_lbs": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Estimated Weight Lbs"
          },
          "expiry_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiry Date"
          },
          "storage_type": {
            "type": "string",
            "enum": [
              "ambient",
              "refrigerated",
              "frozen"
            ],
            "title": "Storage Type"
          },
          "source_index": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Index"
          }
        },
        "type": "object",
        "required": [
          "name",
          "category",
          "quantity",
          "unit",
          "estimated_weight_lbs",
          "storage_type"
        ],
        "title": "ConfirmItem"
      },
      "ConfirmRequest": {
        "properties": {
          "donor_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Donor Id"
          },
          "donor_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Donor Name"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ConfirmItem"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ConfirmRequest"
      },
