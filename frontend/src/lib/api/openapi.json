    "/api/forecasts/run": {
      "post": {
        "tags": [
          "forecasts"
        ],
        "summary": "Run Forecast",
        "description": "Train once on all history and save next week's forecast. Takes a few seconds; the slow\n12-week backtest is a separate command (`make backtest`).",
        "operationId": "run_forecast_api_forecasts_run_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastRunOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/forecasts/runs/latest": {
      "get": {
        "tags": [
          "forecasts"
        ],
        "summary": "Latest Runs",
        "operationId": "latest_runs_api_forecasts_runs_latest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
